# Copy to deploy/.env and fill in. Never commit .env.
# SQL Server 'sa' password: 8+ chars, upper, lower, digit, symbol.
SA_PASSWORD=Change_Me_Str0ng!
# JWT signing key: at least 32 random bytes. Generate: openssl rand -base64 48
JWT_KEY=change-me-to-a-random-64-char-secret-change-me-to-a-random-64-char
# Public URL the browser uses (CORS origin). Dev: http://localhost:8080
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
SWAGGER_ENABLED=false
ASPNETCORE_ENVIRONMENT=Production
MSSQL_PID=Express
# Production overlay only
DOMAIN=app.example.in
ACME_EMAIL=you@example.in
BACKUP_RETENTION_DAYS=14
